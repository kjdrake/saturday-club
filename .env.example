# Copy to .env. Never commit .env.
DOMAIN=pickem.example.com
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Commissioner
ADMIN_PASSWORD=replace-with-a-long-random-password
COOKIE_SECURE=true
DATABASE_PATH=/data/club.db
# Optional: improves point-spread coverage. Never put this in browser code.
ODDS_API_KEY=

# Optional social sign-in. Configure each provider independently; keep secrets server-side.
APP_URL=https://4thandsoul.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional automatic invitation email. Verify the domain in SES and grant the runtime role ses:SendEmail.
AWS_REGION=us-east-1
SES_FROM_EMAIL=
